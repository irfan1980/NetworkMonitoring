# Relay root socket; must match the relay's configured port. Android emulator -> host: 10.0.2.2
EXPO_PUBLIC_RELAY_WS_URL=ws://<relay-host>:<port>/ws

# 1 = bundled fixture, no relay. Must be 0 for live and wall-display builds.
EXPO_PUBLIC_FIXTURE=0

# Web push VAPID key (Firebase console -> Cloud Messaging -> Web Push certificates).
# Only needed when dashboard/firebase/google-services-web.json has no vapidKey.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase client files (git-ignored) go in dashboard/firebase/ on the dashboard server:
#   google-services-android.json, google-services-ios.plist, google-services-web.json
# The web file carries the web config and vapidKey; see README "Firebase files".
